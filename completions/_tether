_tether() {
  local context=''
  local word
  local consume_value=0
  local options_done=0
  for word in ${words[2,$((CURRENT - 1))]}; do
    if (( consume_value )); then
      consume_value=0
      continue
    fi
    if (( options_done )); then
      continue
    fi
    if [[ "$word" == '--' ]]; then
      options_done=1
      continue
    fi
    case "$context:$word" in
      'connect:--session') consume_value=1; continue ;;
      'connect:--session='*) continue ;;
      'connect:--mode') consume_value=1; continue ;;
      'connect:--mode='*) continue ;;
      'connect:--pin') consume_value=1; continue ;;
      'connect:--pin='*) continue ;;
      'plan:--host') consume_value=1; continue ;;
      'plan:--host='*) continue ;;
      'plan:--session') consume_value=1; continue ;;
      'plan:--session='*) continue ;;
      'plan:--native') consume_value=1; continue ;;
      'plan:--native='*) continue ;;
      'plan:--native-raw') consume_value=1; continue ;;
      'plan:--native-raw='*) continue ;;
      'plan:--mode') consume_value=1; continue ;;
      'plan:--mode='*) continue ;;
      'plan:--pin') consume_value=1; continue ;;
      'plan:--pin='*) continue ;;
      'probe:--host') consume_value=1; continue ;;
      'probe:--host='*) continue ;;
      'status:--host') consume_value=1; continue ;;
      'status:--host='*) continue ;;
    esac
    case "$context:$word" in
      ':completion') context='completion' ;;
      ':connect') context='connect' ;;
      ':plan') context='plan' ;;
      ':probe') context='probe' ;;
      ':hosts') context='hosts' ;;
      ':status') context='status' ;;
      ':completion') context='completion' ;;
    esac
  done
  case "$context" in
    '')
      _arguments \
        '(-h)--help[Print command help]' \
        '--version[Write the version to stdout]' \
        '1:command:(completion connect plan probe hosts status completion)'

      ;;
    'completion')
      _arguments \
        '2:shell:(bash zsh fish nu)'
      ;;
    'connect')
      _arguments \
        '--session[Session to attach with zmx or tmux when no inner argv is given; overrides defaults.session]:value:' \
        '--mode[Ordering mode; overrides the config]:value:__tether_completion_values_1' \
        '--pin[Tier that must win; overrides the config]:value:__tether_completion_values_2' \
        '--dry-run[Write the plan JSON and exit without connecting]' \
        '--quiet[Do not announce the winning hop on stderr]' \
        '--no-probe[Never run the ssh round trip; plan from the cache only]' \
        '(-h)--help[Print command help]' \
        '*:argument:__tether_completion_values_0'

      ;;
    'plan')
      _arguments \
        '--host[ssh config alias or tailnet peer]:value:__tether_completion_values_3' \
        '--session[Session name echoed in the output]:value:' \
        '--native[Opaque ref of the callers native mux domain]:value:' \
        '--native-raw[Opaque ref of the callers raw ssh domain]:value:' \
        '--mode[Ordering mode; overrides the config]:value:__tether_completion_values_4' \
        '--pin[Tier that must win; overrides the config]:value:__tether_completion_values_5' \
        '(-h)--help[Print command help]' \
        '*:argument:'

      ;;
    'probe')
      _arguments \
        '--host[ssh config alias or tailnet peer]:value:__tether_completion_values_6' \
        '--force[Probe even inside the unreachable-host backoff]' \
        '(-h)--help[Print command help]' \
        '*:argument:'

      ;;
    'hosts')
      _arguments \
        '--json[Write tether.hosts/v1 instead of a table]' \
        '--names[Write one name per line, for completion]' \
        '(-h)--help[Print command help]' \
        '*:argument:'

      ;;
    'status')
      _arguments \
        '--host[Only this host]:value:__tether_completion_values_7' \
        '(-h)--help[Print command help]' \
        '*:argument:'

      ;;
    'completion')
      _arguments \
        '2:shell:(bash zsh fish nu)'
      ;;
  esac
}
